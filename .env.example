# For local development only, never use these sample credentials in hosted environments.
POSTGRES_USER=trippy
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_DB=trippy
APP_ENV=local
ALLOW_DEV_AUTH=true
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Hosted preview configuration (set in the dedicated provider, separately from local settings)
# APP_ENV=preview
# ALLOW_DEV_AUTH=false
# ACTIVE_CITIES=dhaka
# CORS_ORIGINS=https://<verified-delivery-pages-hostname>
# NEXT_PUBLIC_API_BASE_URL=https://trippy-delivery-api-dev-1010753880203.asia-south1.run.app
# DATABASE_URL is a backend-only secret. Store the TLS-enabled DSN in Secret Manager.

# Delivery Google OAuth Web client. Configure the same ID in Cloud Run and Cloudflare.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Cloud Run only. Set to the approved administrator’s exact Google email.
GOOGLE_ADMIN_EMAIL=

# Optional additional pin to the verified owner Google sub claim.
GOOGLE_ADMIN_SUBJECT=

# Commercial activation is a separate, explicit owner decision. Keep false in preview.
LIVE_ORDERS_ENABLED=false
PILOT_APPROVED=false
# Internal browser QA build only; NEVER set this in Cloudflare Pages.
# NEXT_PUBLIC_INTERNAL_QA=true
# Optional isolated-schema PostgreSQL tests; backend-only, never commit its value.
# TRIPPY_TEST_DATABASE_URL=
